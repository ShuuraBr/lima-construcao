{
  "name": "lima-construcao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrar-prod.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:prod": "node scripts/migrar-prod.mjs",
    "db:studio": "prisma studio",
    "painel:admin": "node scripts/criar-admin.mjs",
    "painel:senha": "node scripts/definir-senha.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.0",
    "prisma": "6.16.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.4"
  }
