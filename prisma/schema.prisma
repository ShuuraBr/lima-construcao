// Lima Construção e Instalação — modelo de dados
// Site institucional (formulário de orçamento) + painel administrativo.
// Painel: usuários com convite seguro; contratos, prestação de serviço,
// agenda e mapa entram nas próximas etapas neste mesmo schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL — é o banco disponível na hospedagem da Hostinger (porta 3306).
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ServicoTipo {
  DRYWALL
  STEEL_FRAME
  ELETRICA
  HIDRAULICA
  FORRO
  ACABAMENTO
  ALVENARIA // não oferecida no site por ora (sem mão de obra) — mantida para uso futuro
  MAIS_DE_UMA_FRENTE
}

enum OrcamentoStatus {
  NOVO
  EM_ANALISE
  COTACAO_ENVIADA
  APROVADO
  RECUSADO
}

/// Pedido de orçamento recebido pelo formulário público do site.
model PedidoOrcamento {
  id        String          @id @default(cuid())
  protocolo String          @unique
  status    OrcamentoStatus @default(NOVO)

  // Contato de quem solicita
  nome     String
  empresa  String?
  email    String
  telefone String

  // Dados da obra
  servico       ServicoTipo
  enderecoObra  String    @map("endereco_obra") @db.VarChar(255)
  metragemM2    Int?      @map("metragem_m2")
  prazoDesejado String?   @map("prazo_desejado")
  dataInicio    DateTime? @map("data_inicio")
  mensagem      String?   @db.Text
  anexoNome     String?   @map("anexo_nome") @db.VarChar(255)

  // Metadados
  origem       String   @default("site")
  ipHash       String?  @map("ip_hash")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([status, criadoEm])
  @@map("pedidos_orcamento")
}

// ============================================================
//  PAINEL ADMINISTRATIVO
// ============================================================

/// Usuário interno do painel. Perfil único (sem hierarquia de acesso).
/// A senha só existe depois que o usuário aceita o convite e a define.
model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  nome         String
  cargo        String    @default("Colaborador")
  senhaHash    String?   @map("senha_hash")
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime? @map("ultimo_acesso")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  tokens TokenAcesso[]

  @@map("usuarios")
}

enum TokenTipo {
  CONVITE
  RECUPERACAO
}

/// Token de uso único para o fluxo de convite / redefinição de senha.
/// Guardamos apenas o hash do token; o valor em claro vai só no link enviado.
model TokenAcesso {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  tipo      TokenTipo @default(CONVITE)
  usuarioId String    @map("usuario_id")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([usuarioId])
  @@map("tokens_acesso")
}
