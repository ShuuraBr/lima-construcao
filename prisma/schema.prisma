// Lima Construção e Instalação — modelo de dados
// Site institucional (formulário de orçamento) + painel administrativo.
// Painel: usuários com convite seguro; contratos, prestação de serviço,
// agenda e mapa entram nas próximas etapas neste mesmo schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL — é o banco disponível na hospedagem da Hostinger (porta 3306).
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ServicoTipo {
  DRYWALL
  STEEL_FRAME
  ELETRICA
  HIDRAULICA
  FORRO
  ACABAMENTO
  ALVENARIA // não oferecida no site por ora (sem mão de obra) — mantida para uso futuro
  MAIS_DE_UMA_FRENTE
}

enum OrcamentoStatus {
  NOVO
  EM_ANALISE
  COTACAO_ENVIADA
  APROVADO
  RECUSADO
}

/// Pedido de orçamento recebido pelo formulário público do site.
model PedidoOrcamento {
  id        String          @id @default(cuid())
  protocolo String          @unique
  status    OrcamentoStatus @default(NOVO)

  // Contato de quem solicita
  nome     String
  empresa  String?
  email    String
  telefone String

  // Dados da obra
  servico       ServicoTipo
  enderecoObra  String    @map("endereco_obra") @db.VarChar(255)
  metragemM2    Int?      @map("metragem_m2")
  prazoDesejado String?   @map("prazo_desejado")
  dataInicio    DateTime? @map("data_inicio")
  mensagem      String?   @db.Text
  anexoNome     String?   @map("anexo_nome") @db.VarChar(255)

  // Metadados
  origem       String   @default("site")
  ipHash       String?  @map("ip_hash")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([status, criadoEm])
  @@map("pedidos_orcamento")
}

// ============================================================
//  PAINEL ADMINISTRATIVO
// ============================================================

/// Usuário interno do painel. Perfil único (sem hierarquia de acesso).
/// A senha só existe depois que o usuário aceita o convite e a define.
model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  nome         String
  cargo        String    @default("Colaborador")
  senhaHash    String?   @map("senha_hash")
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime? @map("ultimo_acesso")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  tokens TokenAcesso[]

  @@map("usuarios")
}

enum TokenTipo {
  CONVITE
  RECUPERACAO
}

/// Token de uso único para o fluxo de convite / redefinição de senha.
/// Guardamos apenas o hash do token; o valor em claro vai só no link enviado.
model TokenAcesso {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  tipo      TokenTipo @default(CONVITE)
  usuarioId String    @map("usuario_id")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([usuarioId])
  @@map("tokens_acesso")
}

enum ContratoStatus {
  ORCAMENTO_APROVADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO
}

/// Contrato firmado com um cliente. O status acompanha a prestação de serviço
/// (orçamento aprovado → em execução → concluído).
model Contrato {
  id     String         @id @default(cuid())
  numero String         @unique
  status ContratoStatus @default(ORCAMENTO_APROVADO)

  // Cliente
  clienteNome     String  @map("cliente_nome")
  clienteEmpresa  String? @map("cliente_empresa")
  clienteEmail    String? @map("cliente_email")
  clienteTelefone String? @map("cliente_telefone")

  // Obra
  // Endereço da obra — estruturado (rastreabilidade) + linha única montada.
  enderecoObra String  @map("endereco_obra") @db.VarChar(255)
  cep            String? @db.VarChar(9)
  logradouro     String? @db.VarChar(180)
  enderecoNumero String? @map("endereco_numero") @db.VarChar(30)
  complemento    String? @db.VarChar(120)
  bairro         String? @db.VarChar(120)
  cidade         String? @db.VarChar(120)
  uf             String? @db.VarChar(2)
  latitude     Float?
  longitude    Float?

  servicos     Json // lista de ServicoTipo
  valor        Decimal     @db.Decimal(12, 2)
  progresso    Int         @default(0) // 0–100

  // Datas
  dataAssinatura  DateTime? @map("data_assinatura")
  inicioPrevisto  DateTime? @map("inicio_previsto")
  entregaPrevista DateTime? @map("entrega_prevista")
  entregaReal     DateTime? @map("entrega_real")

  observacoes String? @db.Text

  // Origem (opcional): orçamento aprovado que virou este contrato
  pedidoOrcamentoId String? @unique @map("pedido_orcamento_id")

  apontamentos Apontamento[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([status, criadoEm])
  @@map("contratos")
}

enum VisitaStatus {
  SOLICITADA
  CONFIRMADA
  REALIZADA
  CANCELADA
}

/// Solicitação de visita técnica. Origem: formulário do site ou cadastro manual
/// no painel. O Erick confirma manualmente data e hora — não há autoagendamento.
model Visita {
  id     String       @id @default(cuid())
  status VisitaStatus @default(SOLICITADA)

  // Contato de quem solicita
  nome     String
  empresa  String?
  email    String?
  telefone String?

  endereco   String  @db.VarChar(255)
  preferencia String? @db.Text // preferência de data/horário informada pelo solicitante
  mensagem   String? @db.Text

  // Preenchido pelo Erick ao confirmar
  agendadaEm          DateTime? @map("agendada_em")
  observacoesInternas String?   @map("observacoes_internas") @db.Text

  // Vínculos opcionais (informativos)
  contratoId        String? @map("contrato_id")
  pedidoOrcamentoId String? @map("pedido_orcamento_id")

  origem       String   @default("site")
  ipHash       String?  @map("ip_hash")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([status, criadoEm])
  @@index([agendadaEm])
  @@map("visitas")
}

/// Registro de andamento da execução de um contrato (prestação de serviço).
/// Cada apontamento guarda um retrato do progresso/status naquele momento e
/// atualiza o contrato correspondente.
model Apontamento {
  id         String   @id @default(cuid())
  contratoId String   @map("contrato_id")
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  data      DateTime     @default(now())
  frente    ServicoTipo?
  progresso Int // retrato 0–100
  status    ContratoStatus
  nota      String? @db.Text

  autorId   String? @map("autor_id")
  autorNome String  @map("autor_nome")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([contratoId, data])
  @@map("apontamentos")
}
