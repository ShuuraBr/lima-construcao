# Banco de dados (MySQL) — duas formas, escolha uma:
#
# (A) variáveis separadas — recomendado em produção (a senha pode ter @, :, /
#     sem precisar de encode). Se DB_HOST estiver definido, ele tem prioridade.
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""        # na Hostinger costuma ser igual ao DB_NAME
DB_PASS=""        # valor cru, sem URL-encode
#
# (B) URL única — usada quando DB_HOST está vazio. Senha com caracteres
#     especiais precisa de encode: "@" -> "%40", ":" -> "%3A" ...
DATABASE_URL="mysql://lima:lima@localhost:3307/lima"

# Envio de e-mail (SMTP) — conta de e-mail da Hostinger em produção
# Enquanto não configurado, os pedidos de orçamento são apenas gravados no banco
# e registrados no log do servidor (nada é enviado).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# Remetente e destinatário das notificações de orçamento
MAIL_FROM="Site Lima <site@limaconstrucao.com.br>"
MAIL_TO="erick@limaconstrucao.com.br"

# URL pública do site (usada em metadados / SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Segredo para assinar a sessão do painel (JWT) — gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# O "Mapa de obras" do painel usa Leaflet + OpenStreetMap/CARTO — sem chave de
# API e sem custo. Nada a configurar aqui.
