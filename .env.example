# Banco de dados (MySQL)
# Local (docker compose up -d): usuário/senha "lima"
# Produção (Hostinger): mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
#   - senha com caracteres especiais (@ : / etc.) precisa ser URL-encoded:
#     "@" vira "%40", ":" vira "%3A" ...
DATABASE_URL="mysql://lima:lima@localhost:3307/lima"

# Envio de e-mail (SMTP) — conta de e-mail da Hostinger em produção
# Enquanto não configurado, os pedidos de orçamento são apenas gravados no banco
# e registrados no log do servidor (nada é enviado).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# Remetente e destinatário das notificações de orçamento
MAIL_FROM="Site Lima <site@limaconstrucao.com.br>"
MAIL_TO="erick@limaconstrucao.com.br"

# URL pública do site (usada em metadados / SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Segredo para assinar a sessão do painel (JWT) — gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
